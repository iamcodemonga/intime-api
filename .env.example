NODE_ENV=development
PORT=3001

# Supabase Postgres — Transaction pooler (app queries). Append ?pgbouncer=true
DATABASE_URL=postgresql://postgres.ucrqdahteepikocgenhc:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct or session pooler URL used by Prisma migrate/seed
DIRECT_URL=postgresql://postgres.ucrqdahteepikocgenhc:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://ucrqdahteepikocgenhc.supabase.co
# Required to invite mechanics (Dashboard → Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Resend (optional in local; required to email drivers on completed inspections)
RESEND_API_KEY=
EMAIL_FROM=Intime <onboarding@resend.dev>

# PDF reports (Playwright). Optional override when bundled Chromium is unavailable.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
